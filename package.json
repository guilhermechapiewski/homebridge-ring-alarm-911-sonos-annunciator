{
  "name": "homebridge-ring-alarm-911-sonos-annunciator",
  "displayName": "Ring Alarm Sonos Announcer",
  "version": "0.0.1",
  "private": true,
  "description": "Homebridge plugin that makes your Sonos speakers announce it out loud when your Ring Alarm goes off.",
  "license": "ISC",
  "author": "Guilherme Chapiewski",
  "homepage": "https://github.com/guilhermechapiewski/homebridge-ring-alarm-911-sonos-annunciator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermechapiewski/homebridge-ring-alarm-911-sonos-annunciator.git"
  },
  "bugs": {
    "url": "https://github.com/guilhermechapiewski/homebridge-ring-alarm-911-sonos-annunciator/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "hoobs-plugin",
    "hoobs",
    "ring",
    "ring-alarm",
    "sonos",
    "alarm",
    "announcement",
    "homekit"
  ],
  "engines": {
    "node": ">=20.18.1",
    "homebridge": "^1.3.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "audio",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings=0 src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "homebridge": "^1.11.4",
    "jest": "^29.7.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/e2e/"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  },
  "dependencies": {
    "ring-client-api": "^14.3.0"
  }
}
